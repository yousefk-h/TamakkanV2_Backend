# Tamakkan backend - copy to `.env` (git-ignored) next to docker-compose.yml and fill in the real values.
# Placeholders look like <...>; every line marked REQUIRED must be set before the API will serve real traffic.
# Deployment-only variables (not read by the app, set in the shell / CI): TAMAKKAN_IMAGE_TAG, TAMAKKAN_COMPOSE_PROJECT (must be tamakkan-backend), TAMAKKAN_API_HOST_PORT (default 4652).
# The avatar agent (livekit_agent/) is a separate deployable with its own file: livekit_agent/.env.example.

# ---- App ----
PROJECT_NAME=Tamakkan Backend
# REQUIRED. "production" on a server. Anything but "development" refuses the placeholder JWT secret below.
ENVIRONMENT=production
API_PREFIX=/api
# DEV ONLY (local runner). Makes startup refuse any production database / LiveKit project. Never set on a server.
# LOCAL_DEV_MODE=true

# ---- Database ----
# REQUIRED.
MONGODB_URI=<mongodb connection string>
# REQUIRED, no default: the name of this deployment's EXISTING database. Never rename a live database.
MONGODB_DB_NAME=tamakkan

# ---- Auth ----
# REQUIRED. Long random value (python -c "import secrets; print(secrets.token_urlsafe(64))"). Changing it signs everyone out.
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Web ----
# REQUIRED. JSON list of the browser origins allowed to call the API (the public frontend URL).
CORS_ORIGINS=["https://<frontend domain>"]
# Hard ceiling on a request body. Must stay above the largest upload (80 MB end-of-week video) plus overhead.
MAX_REQUEST_BODY_BYTES=94371840

# ---- Email ----
# Optional. Verification needs SMTP (or, in development only, EMAIL_DELIVERY_MODE=file). Delivery modes: logging | file | smtp.
EMAIL_VERIFICATION_ENABLED=false
# Must be an https origin outside development (the public frontend URL).
EMAIL_VERIFICATION_BASE_URL=https://<frontend domain>
EMAIL_VERIFICATION_TTL_HOURS=24
EMAIL_BRAND_NAME=Tamakkan
EMAIL_DELIVERY_MODE=logging
# DEV ONLY: where EMAIL_DELIVERY_MODE=file writes .eml files.
# EMAIL_PREVIEW_DIRECTORY=.tamakkan/mail-preview
# With EMAIL_DELIVERY_MODE=smtp: SMTP_HOST and SMTP_FROM_EMAIL are required; set SMTP_USERNAME and SMTP_PASSWORD together or not at all.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ---- Uploads, lessons and reports (optional; the feature fails loudly when its key is empty) ----
# Recording submissions (audio) and topic thumbnails.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# "Video length" badge on a topic. Empty just hides the badge.
YOUTUBE_API_KEY=
# Transcripts, lesson drafting and the scored session reports.
GEMINI_API_KEY=
LOCAL_ASR_MODEL=base.en
# A topic stuck in `extracting` longer than this counts as abandoned. Must exceed the slowest realistic run.
TRANSCRIPT_EXTRACTION_TIMEOUT_MINUTES=30

# ---- LiveKit (Avatar Practice and Voice Practice) ----
# REQUIRED for live sessions: one LiveKit Cloud project. The same project hosts both agents below.
# Empty LIVEKIT_URL = live sessions answer 503 and everything else still works.
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Dispatch name of the Avatar Practice agent. MUST equal the avatar agent's LIVEKIT_AGENT_NAME.
# Never set it empty (that is not the same as unset). Unset = "mariam-agent".
LIVEKIT_AGENT_NAME=<avatar agent dispatch name>
# Dispatch name of the Voice Practice agent. REQUIRED in production: the code default is a DEV agent name.
LIVEKIT_VOICE_AGENT_NAME=<voice agent dispatch name>
# Shared secret the avatar agent sends back to this API (mark-connected / mark-ended).
# MUST equal the avatar agent's AGENT_INTERNAL_API_KEY. Empty rejects every internal call.
AGENT_INTERNAL_API_KEY=

# ---- SpatialReal (new platform, api.spatialreal.com) - ONE matched set ----
# The API key never leaves this server: it is exchanged per Avatar session for a short-lived token, and only that token plus
# the two public ids reach the browser. The trio MUST be the same one the avatar agent uses (livekit_agent/.env.example).
# Empty = POST /sessions/{id}/avatar-token answers 503.
SPATIALREAL_API_KEY=
SPATIALREAL_APP_ID=
SPATIALREAL_AVATAR_ID=
