# Tamakkan Avatar agent (Mariam) - a separate deployable from the backend. Copy to `.env` in this directory (git-ignored)
# for a local run. On LiveKit Cloud the same names are set as agent secrets (`lk agent update-secrets`), not as a file;
# LiveKit Cloud supplies LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET to a hosted agent itself.

# ---- Backend callbacks ----
# REQUIRED. The backend's base URL INCLUDING its API prefix. For a hosted agent it must be publicly reachable (https).
# This worker has no database of its own; it only reports a session connecting / ending to this URL.
BACKEND_API_URL=https://<backend domain>/api/v1
# REQUIRED. Sent as X-Internal-Api-Key on every call above. MUST equal the backend's AGENT_INTERNAL_API_KEY.
AGENT_INTERNAL_API_KEY=

# ---- Conversation models ----
# REQUIRED. OpenAI Realtime is the primary model.
OPENAI_API_KEY=
# REQUIRED. Ultravox is the fallback if the OpenAI session dies mid-call.
ULTRAVOX_API_KEY=

# ---- LiveKit (local run only; hosted agents receive these from LiveKit Cloud) ----
# MUST be the same project as the backend's LIVEKIT_* values.
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# The name this worker registers under. MUST equal the backend's LIVEKIT_AGENT_NAME. Never set it empty (unset = "mariam-agent").
# LiveKit routes by name across EVERY worker registered under it, so a local run needs its own name (e.g. <name>-local)
# set identically in the backend, or real student sessions would be dispatched to your machine.
LIVEKIT_AGENT_NAME=<avatar agent dispatch name>

# ---- SpatialReal (new platform) - ONE matched set ----
# REQUIRED. MUST be the same trio the backend holds (it mints the browser's session token from it).
SPATIALREAL_API_KEY=
SPATIALREAL_APP_ID=
SPATIALREAL_AVATAR_ID=

# ---- Behaviour ----
# Seconds without user input before a session is auto-ended (code default 60).
MARIAM_IDLE_TIMEOUT_SECONDS=120
